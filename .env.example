# Application
APP_ENV=development
HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=false
FLASK_SECRET_KEY=

# Optional. Leave empty to use instance/interview.db.
DATABASE_URL=

# Interview behavior
QUESTIONS_PER_SESSION=5
MIN_INTERVIEW_COMPLETION_RATIO=0.6

# OpenAI-compatible LLM service (optional)
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# OpenAI-compatible embedding service (optional, e.g. SiliconFlow)
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32
RAG_MIN_RELEVANCE=0.25
RAG_MIN_SEMANTIC_SIMILARITY=0.52

# Optional comma-separated browser origins allowed to submit state-changing requests.
# Same-origin requests are allowed automatically.
TRUSTED_ORIGINS=
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300

# iFlytek ASR service (optional)
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
ASR_TIMEOUT_SECONDS=20
ASR_MAX_AUDIO_BYTES=4000000
ASR_MAX_DURATION_SECONDS=60
ASR_RECEIPT_MAX_AGE_SECONDS=900

# Optional demo administrator created by scripts/init_db.py --create-admin
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=
